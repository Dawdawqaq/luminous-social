# ==========================================
# Luminous - 开源安全与开发隔离防线 (.gitignore)
# ==========================================

# --- [内部研发/调试文档与 Agent 协作档案] ---
doc/
docs/
AGENTS.md
agent.md
CLAUDE.md
GEMINI.md
_Run_*.java
_Run_*.class
# 本地测试产物、审查截图和设计工具缓存不发布到源码仓库。
/output/
.impeccable/

# --- [敏感环境配置与密钥 (保留 .env.example 模板)] ---
.env
.env.dev
.env.prod
.env*.local
.local/
!.env.example

# --- [前端开发与构建隔离] ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
output/playwright/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# --- [后端 Maven 与 JVM 构建隔离] ---
backend/target/
backend/*.log
backend/uploads/
backend/src/main/resources/db/migration/*.class

# --- [用户上传的多媒体图库目录] ---
uploads/
uploads-test/

# --- [主流开发工具 IDE 配置隔离] ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
.metadata/

# --- [系统临时与垃圾文件] ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
