# 独立生产模拟配置模板；不覆盖现有 .env，所有占位密码必须替换。
COMPOSE_PROJECT_NAME=luminous-prod
DB_NAME=luminous_prod
DB_USER=luminous_prod_user
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-a-random-database-root-password
MYSQL_PORT=33066
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_PORT=63790
MINIO_ROOT_USER=luminous_prod_admin
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
MINIO_BUCKET=luminous-prod-uploads
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
STORAGE_TYPE=minio
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=1440
APP_PUBLIC_BASE_URL=http://localhost
MINIO_PUBLIC_ENDPOINT=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
PROD_HTTP_PORT=80
PROXY_IP=172.30.50.10
PROXY_SUBNET=172.30.50.0/24
SECURE_COOKIES=false
ROCKETMQ_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=管理员
# 使用 TLS 覆盖时填写真实证书路径，并将上面两个公开地址和 CORS 改为 HTTPS。
TLS_CERT_FILE=
TLS_KEY_FILE=
