# ==============================================================================
# Luminous - Environment Configuration Template
# Copy this file to .env before running: cp .env.example .env
# ==============================================================================

# Project Name (Docker container & volume prefix)
COMPOSE_PROJECT_NAME=luminous

# Host Exposed Ports
MYSQL_PORT=3306
REDIS_PORT=6379
NAMESRV_PORT=9876
BROKER_PORT=10911
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Database Configuration
DB_NAME=luminous
DB_USER=luminous
DB_PASSWORD=luminous_password
DB_ROOT_PASSWORD=luminous_root_password
DB_HOST=mysql
DB_PORT=3306

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RocketMQ Configuration
ROCKETMQ_ENABLED=true
ROCKETMQ_NAMESRV=namesrv:9876
ROCKETMQ_BROKER_IP=127.0.0.1

# Object Storage (local / minio)
STORAGE_TYPE=local
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=luminous_admin
MINIO_SECRET_KEY=luminous_secret_password
MINIO_BUCKET=luminous-uploads

# Application Settings
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost
